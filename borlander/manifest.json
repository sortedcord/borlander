{
    "manifest_version": 3,
    "name": "Borlander",
    "version": "1.0",
    "description": "Applies the classic Borland blue and yellow theme to all websites.",
    "permissions": [
        "storage",
        "tabs",
        "scripting"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "exclude_matches": [
                "*://monkeytype.com/*",
                "*://*.monkeytype.com/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "styles.css",
                "sites/sonarr.local/styles.css",
                "sites/chess.com/styles.css",
                "sites/gitea.local/styles.css",
                "sites/anilist.co/styles.css",
                "sites/github.com/styles.css"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}